# Copy to .env. Never commit .env.
POSTGRES_USER=pvmaps
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pvmaps
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=8080

# ARCHITECTURE.md 9.2: permit only the deployed web origin.
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

PVMAPS_LOG_LEVEL=info

# Live roof measurement (SAM2 on the GPU). The API degrades to "measurement
# unavailable" on that one route if this is unreachable; nothing else stops.
SEGMENTER_PORT=8100
SEGMENTER_URL=http://segmenter:8100

# HMAC key for the confirmed-connection store (api/connection_id.py).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# EMPTY DISABLES PERSISTENCE ENTIRELY -- confirmed rooftops then last only until
# the container restarts. CHANGING IT ORPHANS EVERY STORED ROOFTOP: the digests
# stop matching and no connection is ever found by its number again.
CONNECTION_HASH_KEY=

# MapmyIndia / Mappls (https://apis.mappls.com/console/)
# Provides hyper-local building and door-number level geocoding in India.
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
MAPPLS_REST_KEY=

# Used by alembic and the pipeline (note the different drivers).
DATABASE_URL=postgresql+asyncpg://pvmaps:change-me@localhost:5432/pvmaps
