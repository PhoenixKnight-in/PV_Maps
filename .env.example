# Copy to .env. Never commit .env.
POSTGRES_USER=pvmaps
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pvmaps
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=8080

# ARCHITECTURE.md 9.2: permit only the deployed web origin.
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

PVMAPS_LOG_LEVEL=info

# Used by alembic and the pipeline (note the different drivers).
DATABASE_URL=postgresql+asyncpg://pvmaps:change-me@localhost:5432/pvmaps
